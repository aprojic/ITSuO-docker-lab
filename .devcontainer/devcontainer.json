{
    "name": "Debian",
    "image": "mcr.microsoft.com/devcontainers/base:debian-12", // Switch to a Debian-based image
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest"
        }
    },
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y asciinema && asciinema rec "${GITHUB_USER}_$(date +%Y-%m-%d.cast""
}
